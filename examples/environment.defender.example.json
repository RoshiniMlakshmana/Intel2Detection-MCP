    "mcp_audit": {
      "table": "MCPAudit_CL",
      "fields": ["TimeGenerated", "event_type_s", "execution_status_s", "authorization_decision_s", "principal_id_s", "request_id_s", "tool_name_s", "resource_scope_s"]
    }

# Set these in your environment; the app does not load or commit an .env file.
THREAT_RESEARCH_DB=~/.threat-research/intel.sqlite3
NVD_API_KEY=
# Optional GitHub token for increased public commit API quota.
GITHUB_TOKEN=
# Optional native Defender Graph hunting token with ThreatHunting.Read.All.
GRAPH_TOKEN=
# Optional: free ThreatFox Auth-Key for recent high-confidence C2 indicators.
THREATFOX_AUTH_KEY=
DIGEST_TZ=America/Los_Angeles
DIGEST_TIME=08:00
# The separate live worker polls immediately, then every 15 minutes.
POLL_INTERVAL_MINUTES=15
# Optional immediate high-priority alert recipient; defaults to DIGEST_TO.
ALERT_TO=
# Set true to email all new research/detection commit leads too (can be noisy).
ALERT_RESEARCH=false
# Optional email delivery. Without both DIGEST_TO and SMTP_HOST, a local text digest is saved.
DIGEST_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Analyst dashboard (threat-research dashboard). Defaults shown; all optional.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# Poll once at dashboard startup and once every 24h (set false if serve-live
# already polls this same database).
DASHBOARD_AUTO_REFRESH=true
# How many queued articles the review backlog drains per poll cycle (1-40).
ARTICLE_REVIEW_BATCH_SIZE=18
# Local, Git-ready rule repository (draft/ and approved/ folders). Default:
# a "rule-repository" folder beside THREAT_RESEARCH_DB (isolated per
# enterprise pack automatically). Override to relocate it explicitly.
RULE_REPOSITORY_DIR=
